// ============================================================
// prisma/schema.prisma — Fixed with proper relation syntax
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  OPERATOR
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  CHEQUE
}

enum KhidmatStatus {
  COMPLETED
  PARTIAL
  RECORD_ONLY
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AuditAction {
  DONATION_CREATED
  DONATION_EMAIL_SENT
  EMAIL_SENT
  EMAIL_RESENT
  EMAIL_FAILED
  WHATSAPP_SENT
  WHATSAPP_DELIVERED
  WHATSAPP_READ
  WHATSAPP_FAILED
  WHATSAPP_PENDING
  DONATION_UPDATED
  DONATION_DELETED
  DONATION_RESTORED
  WHATSAPP_SKIPPED
  OPERATOR_LOGIN
  ADMIN_LOGIN
  EMAIL_CHANGED
  USER_CREATED
  USER_UPDATED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PDF_EXPORTED
  KHIDMAT_CREATED
  KHIDMAT_UPDATED
  KHIDMAT_DELETED
  KHIDMAT_RESTORED
  KHIDMAT_WHATSAPP_SENT
  KHIDMAT_WHATSAPP_FAILED
  KHIDMAT_WHATSAPP_SKIPPED
  KHIDMAT_PAYMENT_ADDED
  KHIDMAT_BULK_REMINDER_SENT
  KHIDMAT_PERSON_WHATSAPP_SENT
  REMINDER_SCHEDULE_CREATED
  REMINDER_SCHEDULE_UPDATED
  REMINDER_SCHEDULE_DELETED
  REMINDER_SCHEDULE_RUN
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(OPERATOR)
  isActive     Boolean   @default(true)

  resetPasswordToken  String?   @unique
  resetPasswordExpiry DateTime?

  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  donationsCreated       Donation[]              @relation("OperatorDonations")
  donationsDeleted       Donation[]              @relation("DeletedDonations")
  khidmatCreated         KhidmatRecord[]         @relation("KhidmatOperator")
  khidmatDeleted         KhidmatRecord[]         @relation("KhidmatDeletedBy")
  reminderSchedules      ReminderSchedule[]
  auditLogs              AuditLog[]

  @@map("users")
}

model Donation {
  id            String        @id @default(uuid())
  donorName     String
  donorEmail    String?
  donorPhone    String
  amount        Decimal       @db.Decimal(10, 2)
  purpose       String
  paymentMethod PaymentMethod
  notes         String?
  date          DateTime      @default(now())

  emailSent     Boolean   @default(false)
  emailSentAt   DateTime?
  emailError    String?
  receiptNumber String?

  whatsappSent      Boolean   @default(false)
  whatsappSentAt    DateTime?
  whatsappMessageId String?   @unique
  whatsappError     String?

  whatsappStatus          String?   @default("PENDING")
  whatsappStatusUpdatedAt DateTime?
  whatsappDeliveryDetails Json?
  whatsappReadAt          DateTime?
  templateUsed            String?
  templateType            String?

  operatorId String
  categoryId String?
  deletedBy  String?

  operator      User              @relation("OperatorDonations", fields: [operatorId], references: [id])
  deletedByUser User?             @relation("DeletedDonations",  fields: [deletedBy],  references: [id])
  category      DonationCategory? @relation(fields: [categoryId], references: [id])

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("donations")
  @@index([operatorId])
  @@index([categoryId])
  @@index([deletedBy])
}

model DonationCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  nameUrdu    String?
  description String?
  icon        String?  @default("Tag")
  color       String?  @default("#3b82f6")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donations      Donation[]
  khidmatRecords KhidmatRecord[]

  @@map("donation_categories")
}

model KhidmatRecord {
  id String @id @default(uuid())

  name     String
  nameUrdu String?
  phone    String
  address  String?

  amount         Decimal @db.Decimal(10, 2)
  receivedAmount Decimal @db.Decimal(10, 2) @default(0)

  categoryId String
  status     KhidmatStatus @default(RECORD_ONLY)
  notes      String?

  whatsappSent            Boolean   @default(false)
  whatsappSentAt          DateTime?
  whatsappMessageId       String?   @unique
  whatsappError           String?
  whatsappStatus          String?   @default("PENDING")
  whatsappStatusUpdatedAt DateTime?

  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletionReason String?

  operatorId String
  deletedBy  String?
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  operator      User              @relation("KhidmatOperator",  fields: [operatorId], references: [id])
  deletedByUser User?             @relation("KhidmatDeletedBy", fields: [deletedBy],  references: [id])
  category      DonationCategory  @relation(fields: [categoryId], references: [id])
  payments      KhidmatPayment[]
  reminderRecords ReminderScheduleRecord[]

  @@map("khidmat_records")
  @@index([operatorId])
  @@index([categoryId])
  @@index([status])
  @@index([deletedBy])
  @@index([phone])
}

model KhidmatPayment {
  id       String  @id @default(uuid())
  recordId String

  amount  Decimal  @db.Decimal(10, 2)
  notes   String?
  paidAt  DateTime @default(now())

  createdAt DateTime @default(now())

  record KhidmatRecord @relation(fields: [recordId], references: [id])

  @@map("khidmat_payments")
  @@index([recordId])
  @@index([paidAt])
}

model ReminderSchedule {
  id           String   @id @default(uuid())
  name         String
  frequency    ScheduleFrequency @default(DAILY)
  time         String?  @default("09:00")  // HH:mm format
  nextRunAt    DateTime
  lastRunAt    DateTime?
  isActive     Boolean  @default(true)
  createdBy    String

  filterStatuses   KhidmatStatus[] @default([PARTIAL, RECORD_ONLY])
  filterCategoryId String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  records       ReminderScheduleRecord[]
  createdByUser User                     @relation(fields: [createdBy], references: [id])

  @@map("reminder_schedules")
  @@index([nextRunAt])
  @@index([isActive])
}

model ReminderScheduleRecord {
  id         String         @id @default(uuid())
  scheduleId String
  recordId   String
  status     ReminderStatus @default(PENDING)
  error      String?
  sentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule ReminderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  record   KhidmatRecord    @relation(fields: [recordId], references: [id])

  @@map("reminder_schedule_records")
  @@index([scheduleId])
  @@index([recordId])
  @@index([status])
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entityType  String
  entityId    String?
  description String
  userRole    Role
  userId      String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  timestamp   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@index([timestamp])
  @@index([userId])
  @@index([action])
  @@index([entityType])
}
